# name: conformance/vss-memory/basic_before_checkpoint.test
# Separately named in-memory supplement; see source-manifest.json and README.md.
# Selected SQL and assertions are unchanged; persistence boundaries are omitted.
require vss

require noforcestorage

load :memory:

# Source: test/sql/hnsw/hnsw_basic.test:12-13
statement ok
CREATE TABLE t1 (vec FLOAT[3]);

# Source: test/sql/hnsw/hnsw_basic.test:15-16
statement ok
INSERT INTO t1 SELECT array_value(a,b,c) FROM range(1,10) ra(a), range(1,10) rb(b), range(1,10) rc(c);

# Source: test/sql/hnsw/hnsw_basic.test:18-19
statement ok
CREATE INDEX my_idx ON t1 USING HNSW (vec);

# Source: test/sql/hnsw/hnsw_basic.test:22-25
query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

# Source: test/sql/hnsw/hnsw_basic.test:29-34
query I
SELECT array_distance([1,2,3]::FLOAT[3], vec) < 1.5 FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 3;
----
true
true
