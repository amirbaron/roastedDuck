# name: conformance/vss-memory/crud_without_restart.test
# Separately named in-memory supplement; see source-manifest.json and README.md.
# Selected SQL and assertions are unchanged; persistence boundaries are omitted.
require vss

require noforcestorage

load :memory:

# Source: test/sql/hnsw/hnsw_crud.test:12-13
statement ok
CREATE TABLE t1 (vec FLOAT[3]);

# Source: test/sql/hnsw/hnsw_crud.test:15-16
statement ok
INSERT INTO t1 VALUES (array[1.0, 2.0, 3.0]);

# Source: test/sql/hnsw/hnsw_crud.test:18-19
statement ok
CREATE INDEX my_idx ON t1 USING HNSW (vec);

# Source: test/sql/hnsw/hnsw_crud.test:24-25
statement ok
INSERT INTO t1 VALUES (array[5.0, 5.0, 5.0]);

# Source: test/sql/hnsw/hnsw_crud.test:27-28
statement ok
DELETE FROM t1 WHERE vec = array[1.0, 2.0, 3.0];

# Source: test/sql/hnsw/hnsw_crud.test:30-33
query I
SELECT * FROM t1;
----
[5.0, 5.0, 5.0]

# Source: test/sql/hnsw/hnsw_crud.test:39-42
query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

# Source: test/sql/hnsw/hnsw_crud.test:44-47
query I
SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 3;
----
[5.0, 5.0, 5.0]

# Source: test/sql/hnsw/hnsw_crud.test:49-50
statement ok
PRAGMA hnsw_compact_index('my_idx');

